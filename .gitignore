__pycache__/
*.py[cod]

# --- process machinery (see AGENTS.md) ---
# One worktree per writer lives in-repo (never /tmp: in this harness a /tmp write
# can be a per-call tmpfs, so a worktree created there does not exist for the next
# call). gitignored so it never appears in the main tree's status or a build.
worktrees/
# The gate's raw logs. Kept IN THE WORKSPACE on purpose, so a background run's
# evidence outlives the process that wrote it.
.gate-logs/
# The ONE gate lock (mkdir-based, shared by every worktree).
.futuremagic-lock/

# --- GENERATED app index: never hand-edit (scripts/generate-app-index.mjs) ---
# A fresh clone has NEITHER file; `npm run build` creates both from the network.
# apps.index.json is what the browser fetches at runtime. apps.json is a byte-identical
# legacy copy that exists ONLY because deploy-clean.ps1:148-150 throws unless
# dist/apps.json exists while :210-215 refuses to upload it. One generator, no drift.
public/apps.index.json
public/apps.json
